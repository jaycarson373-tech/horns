    "ingest:market": "tsx scripts/ingest-market.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "2.100.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "bs58": "6.0.0",
    "dotenv": "17.4.2",
    "next": "16.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.2",
    "tsx": "4.22.4",
    "twitter-api-v2": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=20.10.0"
  }
