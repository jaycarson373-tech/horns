{
  "name": "pumpxbt-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "test": "tsx --test tests/**/*.test.ts",
    "site:start": "next start",
    "typecheck": "tsc --noEmit",
    "start": "npm run poll",
