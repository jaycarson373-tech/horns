# Shared server-side data store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PumpXBT site and 500K token gate
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BOT_HANDLE=
NEXT_PUBLIC_BUY_URL=
NEXT_PUBLIC_PUMPXBT_TOKEN_MINT=
PUMPXBT_TOKEN_MINT=
PUMPXBT_ACCESS_THRESHOLD=500000
PUMPXBT_SESSION_MINUTES=30
HELIUS_API_KEY=
SESSION_SECRET=
CRON_SECRET=

# Read-only market ingestion tuning
PUMP_TOKEN_SUFFIX=pump
HIGH_CONVICTION_MIN_SCORE=85
MIN_SIGNAL_LIQUIDITY_USD=50000
MIN_SIGNAL_VOLUME_24H_USD=100000

# X mention worker (Railway)
BOT_MODE=agent
BOT_USERNAME=PumpXBT
BOT_USER_ID=
BOT_PROJECT_KEY=pumpxbt-agent
DRY_RUN=true
POLL_INTERVAL_MS=60000
MAX_MENTIONS_PER_POLL=100
MAX_GLOBAL_REPLIES_PER_HOUR=20
MAX_USER_REPLIES_PER_HOUR=1
MAX_MENTION_AGE_MINUTES=1440

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Optional OAuth 2.0 user-context token. OAuth 1.0a is used when unset.
X_OAUTH2_USER_TOKEN=
