# Shared server-side data store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PumpXBT site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BOT_HANDLE=PumpXBT_
NEXT_PUBLIC_BUY_URL=
# Public/display copy of the token mint. Safe for the browser.
NEXT_PUBLIC_PUMPXBT_TOKEN_MINT=63rgqN7DhrwEC9xoDLeH8owePssdK6dZYcD5dfJbpump
# Authoritative server-side token mint. Must match the public value.
PUMPXBT_TOKEN_MINT=63rgqN7DhrwEC9xoDLeH8owePssdK6dZYcD5dfJbpump
HELIUS_API_KEY=
PUMPXBT_CREATOR_WALLET=
PUMPXBT_BALANCE_RPC_URL=
SESSION_SECRET=
CRON_SECRET=

# Read-only market ingestion tuning
PUMP_TOKEN_SUFFIX=pump
HIGH_CONVICTION_MIN_SCORE=85
MIN_SIGNAL_LIQUIDITY_USD=50000
MIN_SIGNAL_VOLUME_24H_USD=100000

# X mention worker (Railway)
BOT_MODE=agent
BOT_USERNAME=PumpXBT_
BOT_USER_ID=
BOT_PROJECT_KEY=pumpxbt-agent
DRY_RUN=true
AUTO_TRADE_ENABLED=false
AUTO_TRADE_SOL_AMOUNT=0.1
AUTO_TRADE_FOLLOWER_THRESHOLD=50
AUTO_TRADE_SOL_MINT=So11111111111111111111111111111111111111112
AUTO_TRADE_SLIPPAGE_BPS=80
AUTO_TRADE_RPC_URL=
AUTO_TRADE_QUOTE_API_URL=https://quote-api.jup.ag/v6
# Railway worker secret only. Never set this in NEXT_PUBLIC_*, Vercel, or GitHub.
AUTO_TRADE_PRIVATE_KEY=
# or TRADER_SECRET_KEY
AUTO_TRADE_MAX_CONSECUTIVE_PER_CALLER=0
POLL_INTERVAL_MS=60000
MAX_MENTIONS_PER_POLL=100
MAX_GLOBAL_REPLIES_PER_HOUR=20
MAX_USER_REPLIES_PER_HOUR=10
MAX_MENTION_AGE_MINUTES=1440

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Optional OAuth 2.0 user-context token. OAuth 1.0a is used when unset.
X_OAUTH2_USER_TOKEN=

# LLM reply provider (text mode). Default: openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_VERSION=2023-06-01
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=240
